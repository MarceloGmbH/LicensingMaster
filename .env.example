# Copy to .env and fill in. Used by docker-compose.yml.
#   cp .env.example .env
#   docker compose up -d --build
#
# FRESH environment only (no existing data volume): create it once, because
# docker-compose.yml declares the volume `external`:
#   docker volume create licensing_lm_pgdata

# --- runtime ----------------------------------------------------------------
# production  => session cookie is Secure (HTTPS only), signing key required.
# development => Secure flag relaxed so the portal works over plain http locally.
LM_APP_ENV=production

# Where the container publishes 8000 on the host. On vm-services this is
# 0.0.0.0:3013 so the shared Traefik (vm-gateway) can reach 10.10.4.10:3013.
# Local dev: leave the defaults (127.0.0.1:8010).
LM_BIND_ADDR=0.0.0.0
LM_HOST_PORT=3013

# --- licensing-db ---------------------------------------------------------
LM_POSTGRES_USER=postgres
LM_POSTGRES_PASSWORD=change-me-strong
LM_POSTGRES_DB=sistema_farmacia_licensing

# --- device_config signing -------------------------------------------
# REQUIRED when LM_APP_ENV is not development: the service refuses to start
# without a valid key. Generate the pair with:
#   python licensing-master/scripts/gen_ed25519_keypair.py
# (private -> here; public -> the desktop build's VITE_DEVICE_CONFIG_PUBKEY).
# Empty is accepted only in development/test (unsigned DEVCFG:<hash> digest).
LM_ED25519_PRIVATE_KEY_B64=

# --- admin login (native: password + mandatory TOTP) -------------------
# There is no admin allow-list in the environment: admins live in the database.
# Create the first one inside the container (see deploy.md):
#   docker exec -it <container> python -m src.cli create-admin --email you@example.com
# The portal host must ALSO be restricted to LAN/VPN at Traefik (ipAllowList).
# Session lifetimes: idle timeout slides on every request; absolute never extends.
LM_ADMIN_SESSION_IDLE_SECONDS=1800
LM_ADMIN_SESSION_ABSOLUTE_SECONDS=28800
# Login brute force: lock an e-mail (5 failures / 15 min -> 15 min) and,
# separately, a client IP (10 failures / 15 min -> 15 min). Also guards the
# password re-entered to delete a tenant.
LM_ADMIN_LOGIN_EMAIL_MAX_FAILURES=5
LM_ADMIN_LOGIN_EMAIL_WINDOW_SECONDS=900
LM_ADMIN_LOGIN_EMAIL_LOCKOUT_SECONDS=900
LM_ADMIN_LOGIN_IP_MAX_FAILURES=10
LM_ADMIN_LOGIN_IP_WINDOW_SECONDS=900
LM_ADMIN_LOGIN_IP_LOCKOUT_SECONDS=900

# --- subscription defaults for a freshly created tenant ----------------
LM_DEFAULT_WINDOW_DAYS=30
LM_DEFAULT_GRACE_DAYS=5
LM_DEFAULT_SEAT_LIMIT=5

LM_CORS_ORIGINS=["https://licensing.alanadev.com"]

# --- Cloudflare Tunnel connector (OFF — profile `tunnel`) --------------
# Only needed if you ever switch ingress from Traefik to a real tunnel and run
# `docker compose --profile tunnel up -d`.
CF_TUNNEL_TOKEN=

# --- brute-force throttling (in-memory, per client IP) ------------------
# Public POST /activate: failed token attempts -> 429 TOO_MANY_ATTEMPTS.
LM_ACTIVATE_MAX_FAILURES=10
LM_ACTIVATE_FAILURE_WINDOW_SECONDS=600
LM_ACTIVATE_LOCKOUT_SECONDS=900
# /cp/* service-token authentication failures.
LM_CP_AUTH_MAX_FAILURES=20
LM_CP_AUTH_FAILURE_WINDOW_SECONDS=600
LM_CP_AUTH_LOCKOUT_SECONDS=900
# Proxies whose X-Forwarded-For uvicorn trusts for the real client IP. Set to
# the reverse proxy's (Traefik) IP/CIDR. '*' trusts any peer and takes the
# LEFTMOST XFF entry, so it is only safe if the container is reachable solely
# through a proxy that overwrites X-Forwarded-For.
LM_FORWARDED_ALLOW_IPS=*
